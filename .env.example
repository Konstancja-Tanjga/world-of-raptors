# Accounts (Supabase). Copy to .env.local and fill in from
# Supabase -> Project Settings -> API. Both values are public: they end up in
# the browser, and row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud -> Google Auth Platform -> Clients: the Web client's ID. Public:
# Google's sign-in button needs it in the page. The same ID goes into Supabase
# -> Authentication -> Providers -> Google -> Client IDs.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<number>-<id>.apps.googleusercontent.com

# Shows sign-in in the app. Leave unset (or "false") to deploy without it.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false

# Server only, for "Usuń konto" (phase 5). Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_...
